# NVIDIA DGX Spark Local Environment Configuration
DATABASE_URL=postgresql+psycopg://spark:sparkpassword@localhost:5432/sheffield_s106

# Local LLM Endpoint (Ollama on Spark defaults to :11434/v1, vLLM defaults to :8000/v1)
VLLM_BASE_URL=http://localhost:11434/v1
VLLM_API_KEY=ollama

# Preloaded DGX Spark models:
#   - qwen3.6:35b-a3b
#   - nemotron-3.5-lightning:30b
#   - nemotron-3-nano:30b
VLLM_MODEL_NAME=qwen3.6:35b-a3b

APP_HOST=0.0.0.0
APP_PORT=8080
