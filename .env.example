# NVIDIA DGX Spark Local Environment Configuration
DATABASE_URL=postgresql+psycopg://spark:sparkpassword@localhost:5432/sheffield_s106

# Local Ollama / vLLM Endpoint
# - Laptop via organiser SSH tunnel: http://127.0.0.1:11435
# - Running directly on DGX Spark:  http://127.0.0.1:11434
VLLM_BASE_URL=http://127.0.0.1:11435
VLLM_API_KEY=ollama

# Preloaded DGX Spark models (Nemotron models earn the hackathon bonus):
#   - nemotron-3.5-lightning:30b  (Default: Agent steps - classifying, extracting, routing)
#   - nemotron-3-nano:30b         (Reasoning and code)
#   - qwen3.6:35b-a3b             (Images + text/code)
VLLM_MODEL_NAME=nemotron-3.5-lightning:30b

# Organiser Spark limits: 8,192 tokens per request, one model loaded at a time
LLM_NUM_CTX=8192
LLM_NUM_PREDICT=2048
LLM_KEEP_ALIVE=0

APP_HOST=0.0.0.0
APP_PORT=8080
